{
  "id": "focus-timer",
  "name": "Focus Timer",
  "description": "A Pomodoro timer that switches between focus and break.",
  "version": "1.0.0",
  "entry": "index.html",
  "defaultSize": { "w": 3, "h": 2 },
  "minSize": { "w": 2, "h": 2 },
  "settings": [
    { "key": "focus", "label": "Focus minutes", "type": "number", "default": 25, "min": 1, "max": 180 },
    { "key": "break", "label": "Break minutes", "type": "number", "default": 5, "min": 1, "max": 60 }
  ]
}
